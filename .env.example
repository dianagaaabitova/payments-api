# Local development credentials. Generate independent secrets for any shared deployment.
API_KEY=local-payments-api-key-change-me
WEBHOOK_SIGNING_SECRET=local-signing-secret-change-me-32-bytes
POSTGRES_PASSWORD=payments
RABBITMQ_PASSWORD=payments
# Update these URLs when changing the corresponding credentials. URL-encode passwords.
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/
WEBHOOK_ALLOWED_HOSTS=[]
WEBHOOK_TIMEOUT=5
RETRY_BASE_DELAY=2
